<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="30dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ORÇAMENTOS FÁCIL"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#1E3A5F"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btnNovoOrcamento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NOVO ORÇAMENTO"
        android:layout_marginBottom="15dp" />

    <Button
        android:id="@+id/btnOrcamentosSalvos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ORÇAMENTOS SALVOS"
        android:layout_marginBottom="15dp" />

    <Button
        android:id="@+id/btnConfiguracoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DADOS DA EMPRESA" />

</LinearLayout>