<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- CABEÇALHO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detalhes do Orçamento"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confira os dados, itens e o valor total."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />

        <!-- NÚMERO E CLIENTE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/txtNumero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ORC-00000"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary" />

            <TextView
                android:id="@+id/txtDadosCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cliente: ---"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="14dp" />

        </LinearLayout>

        <!-- ITENS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Itens do orçamento"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <ListView
                android:id="@+id/listItensDetalhe"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:divider="@color/border_light"
                android:dividerHeight="1dp" />

            <TextView
                android:id="@+id/txtTotalDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total: R$ 0,00"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary"
                android:gravity="end"
                android:layout_marginTop="18dp" />

        </LinearLayout>

        <!-- OBSERVAÇÕES -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Observações"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/txtObservacoesDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nenhuma observação."
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <!-- AÇÕES -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGerarPdf"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_button_primary"
            app:backgroundTint="@null"
            android:text="Gerar e compartilhar PDF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/brand_primary" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnExcluir"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_primary"
            app:backgroundTint="@null"
            android:text="Excluir orçamento"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/danger"
            android:layout_marginTop="10dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVoltarDetalhe"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_primary"
            app:backgroundTint="@null"
            android:text="Voltar"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/brand_primary"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

</ScrollView>