<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtNumero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ORC-00000"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1E3A5F" />

        <TextView
            android:id="@+id/txtDadosCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Itens"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <ListView
            android:id="@+id/listItensDetalhe"
            android:layout_width="match_parent"
            android:layout_height="250dp" />

        <TextView
            android:id="@+id/txtObservacoesDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginTop="15dp" />

        <TextView
            android:id="@+id/txtTotalDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: R$ 0,00"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1E3A5F"
            android:gravity="end"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnGerarPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GERAR E COMPARTILHAR PDF"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnExcluir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EXCLUIR ORÇAMENTO"
            android:layout_marginTop="25dp" />

        <Button
            android:id="@+id/btnVoltarDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VOLTAR" />


    </LinearLayout>

</ScrollView>